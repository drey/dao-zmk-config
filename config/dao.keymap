#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick_tap_ms = <200>; };

&mt {
    quick_tap_ms = <120>;
    flavor = "tap-preferred";
};

/ {
    chosen {
        // zmk,matrix_transform = &default_transform;

        zmk,matrix_transform = &extra_keys_transform;
    };
};

/ {
    macros {
        lock_sceen: lock_sceen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI &kp LEFT_CONTROL &kp Q>,
                <&macro_release>,
                <&kp LEFT_GUI &kp LEFT_CONTROL &kp Q>;

            label = "LOCK_SCEEN";
        };

        undo: undo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI &kp Z>,
                <&macro_release>,
                <&kp LEFT_GUI &kp Z>;

            label = "UNDO";
        };

        redo: redo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT &kp LEFT_GUI &kp Z>,
                <&macro_release>,
                <&kp LEFT_SHIFT &kp LEFT_GUI &kp Z>;

            label = "REDO";
        };

        change_layout: change_layout {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI &kp SPACE>,
                <&macro_release>,
                <&kp LEFT_GUI &kp SPACE>;

            label = "CHANGE_LAYOUT";
        };

        double_shift: double_shift {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LEFT_SHIFT>,
                <&macro_wait_time 30>,
                <&kp LEFT_SHIFT>;

            label = "DOUBLE_SHIFT";
        };

        plain_text: plain_text {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT &kp LEFT_GUI &kp K>,
                <&macro_release>,
                <&kp LEFT_SHIFT &kp LEFT_GUI &kp K>;

            label = "PLAIN_TEXT";
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_next {
            timeout-ms = <50>;
            key-positions = <22 23>;
            layers = <2>;
            bindings = <&kp C_NEXT>;
        };

        combo_prev {
            timeout-ms = <50>;
            key-positions = <21 22>;
            layers = <2>;
            bindings = <&kp C_PREVIOUS>;
        };

        combo_pause {
            timeout-ms = <50>;
            key-positions = <21 22 23>;
            layers = <2>;
            bindings = <&kp C_PLAY_PAUSE>;
        };

        lock_screen {
            bindings = <&lock_sceen>;
            key-positions = <16 17 18>;
            layers = <0>;
            timeout-ms = <50>;
        };

        undo {
            bindings = <&undo>;
            key-positions = <21 22>;
            layers = <0>;
            timeout-ms = <50>;
        };

        redo {
            bindings = <&redo>;
            key-positions = <22 23>;
            layers = <0>;
            timeout-ms = <50>;
        };

        double_shift {
            bindings = <&double_shift>;
            key-positions = <39 42>;
            layers = <0>;
        };

        plain_text {
            bindings = <&plain_text>;
            key-positions = <16 17>;
            layers = <0>;
            timeout-ms = <50>;
        };
    };

    behaviors {
        mt_caps_word: mt_caps_word {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_CAPS_WORD";
            bindings = <&caps_word>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            quick-tap-ms = <120>;
        };

        homerow_left: homerow_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            flavor = "tap-preferred";
        };

        homerow_right: homerow_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            flavor = "tap-preferred";
        };

        mt_change_layout: mt_change_layout {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_CHANGE_LAYOUT";
            bindings = <&change_layout>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        mt_shortcut: mt_shortcut {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_SHORTCUT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&sl 3  &mt CAPSLOCK RIGHT_BRACKET  &kp Q                         &kp W                     &kp E                         &kp R                       &kp T                       &kp Y            &kp U                         &kp I                           &kp O                          &kp P                               &mt_caps_word 0 LEFT_BRACKET  &sl 3
       &mt_change_layout 0 GRAVE   &homerow_left LEFT_COMMAND A  &homerow_left LEFT_ALT S  &homerow_left LEFT_CONTROL D  &homerow_left LEFT_SHIFT F  &mt LA(SPACE) G             &kp H            &homerow_right RIGHT_SHIFT J  &homerow_right RIGHT_CONTROL K  &homerow_right LEFT_CONTROL L  &homerow_right RIGHT_GUI SEMICOLON  &kp APOSTROPHE
       &kp MINUS                   &mt_shortcut LG(A) Z          &mt_shortcut LG(X) X      &mt_shortcut LG(C) C          &mt_shortcut LG(V) V        &mt_shortcut LG(LA(V)) B    &kp N            &kp M                         &kp COMMA                       &kp DOT                        &kp FSLH                            &kp BSLH
                                                                                           &lt 2 TAB                     &kp SPACE                   &lt 1 RET                   &lt 1 BACKSPACE  &kp ESCAPE                    &lt 2 DEL
            >;
        };

        lower_layer {
            bindings = <
&trans  &kp KP_NUMLOCK  &kp SLASH                     &kp N7                           &kp N8                         &kp N9                             &kp AT_SIGN    &kp HASH   &kp LEFT_BRACKET                             &kp UNDERSCORE                         &kp PIPE                           &kp RIGHT_BRACKET                           &kp PERCENT  &none
        &kp STAR        &homerow_left LEFT_GUI MINUS  &homerow_left LEFT_ALT NUMBER_4  &homerow_left LEFT_CONTROL N5  &homerow_left LEFT_SHIFT NUMBER_6  &kp KP_PLUS    &kp EQUAL  &homerow_right RIGHT_SHIFT LEFT_PARENTHESIS  &homerow_right RIGHT_CONTROL ASTERISK  &homerow_right LEFT_ALT AMPERSAND  &homerow_right RIGHT_GUI RIGHT_PARENTHESIS  &kp CARET
        &trans          &kp N0                        &kp NUMBER_1                     &kp NUMBER_2                   &kp NUMBER_3                       &kp KP_DOT     &kp EXCL   &kp LEFT_BRACE                               &kp LESS_THAN                          &kp GREATER_THAN                   &kp RIGHT_BRACE                             &kp DOLLAR
                                                                                       &trans                         &trans                             &trans         &trans     &trans                                       &trans
            >;
        };

        raise_layer {
            bindings = <
&trans  &trans  &none         &kp F7                     &kp F8                         &kp F9                       &kp F10    &kp C_VOL_UP  &kp HOME                               &kp PSCRN                              &kp PG_UP                      &kp SLCK                      &none  &none
        &trans  &kp LEFT_GUI  &homerow_left LEFT_ALT F4  &homerow_left LEFT_CONTROL F5  &homerow_left LEFT_SHIFT F6  &kp F11    &kp C_MUTE    &homerow_right RIGHT_SHIFT LEFT_ARROW  &homerow_right RIGHT_CONTROL UP_ARROW  &homerow_right LEFT_ALT RIGHT  &homerow_right RIGHT_GUI INS  &none
        &trans  &none         &kp F1                     &kp F2                         &kp F3                       &kp F12    &kp C_VOL_DN  &kp END                                &kp DOWN                               &kp PG_DN                      &kp PAUSE_BREAK               &none
                                                         &trans                         &trans                       &trans     &trans        &trans                                 &trans
            >;
        };

        adjust_layer {
            bindings = <
&none  &none  &none  &kp LG(F7)  &kp LG(F9)  &kp LG(F8)  &kp LC(LS(C))    &kp C_PREV   &none  &none   &none  &none  &none  &none
       &none  &none  &none       &kp LG(F6)  &none       &none            &kp C_PAUSE  &none  &none   &none  &none  &none
       &none  &none  &none       &none       &none       &none            &kp C_NEXT   &none  &none   &none  &none  &none
                                 &trans      &none       &trans           &trans       &none  &trans
            >;
        };

        system {
            bindings = <
&none  &sys_reset   &none         &none         &none         &none         &none           &none         &none         &none         &none         &none         &sys_reset   &none
       &bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &bt BT_CLR
       &bootloader  &none         &none         &none         &none         &none           &none         &none         &none         &none         &none         &bootloader
                                                &none         &none         &none           &none         &none         &none
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        system {
            if-layers = <1 2>;
            then-layer = <4>;
        };
    };
};
